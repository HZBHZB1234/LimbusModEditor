<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LimbusModEditor.Application\LimbusModEditor.Application.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Infrastructure\LimbusModEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Domain\LimbusModEditor.Domain.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Editing\LimbusModEditor.Editing.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Unity\LimbusModEditor.Formats.Unity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 日志配置随程序发布：autoReload 生效时可在运行中直接改级别（见 docs/LOGGING.md）。 -->
    <None Include="..\..\nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- PerMonitorV2 DPI 感知 + 长路径支持（WebView2 跟随宿主 DPI，Chromium 自行处理 per-monitor） -->
    <ApplicationManifest Include="app.manifest" />
  </ItemGroup>

  <!-- 发布集成：将前端产物 dist/ 复制到输出 wwwroot/ -->
  <PropertyGroup>
    <FrontendDistDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LimbusModEditor.Web\dist'))</FrontendDistDir>
  </PropertyGroup>

  <Target Name="PublishFrontend" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <FrontendFiles Include="$(FrontendDistDir)\**\*" Condition="Exists('$(FrontendDistDir)')" />
    </ItemGroup>
    <Error Condition="!Exists('$(FrontendDistDir)') OR '@(FrontendFiles)' == ''"
           Text="前端产物不存在：$(FrontendDistDir)。请先构建前端：npm --prefix src/LimbusModEditor.Web run build" />
    <Message Importance="high" Text="发布前端产物：@(FrontendFiles->Count()) 个文件从 $(FrontendDistDir) → wwwroot/" />
    <Copy SourceFiles="@(FrontendFiles)"
          DestinationFiles="@(FrontendFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
