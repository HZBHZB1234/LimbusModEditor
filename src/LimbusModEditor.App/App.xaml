<Application x:Class="LimbusModEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LimbusModEditor.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 跨页面共用资源（plan-02：页面化后页面内必须也能解析这些键） -->
        <local:HumanSizeConverter x:Key="HumanSize"/>
        <!-- 列表 / 树 切换按钮 -->
        <Style x:Key="ViewToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1B222B"/>
            <Setter Property="Foreground" Value="#9FB0BF"/>
            <Setter Property="BorderBrush" Value="#2A3540"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 工作区小节标题 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F93A4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Application.Resources>
</Application>
