<UserControl x:Class="LimbusModEditor.App.JsonTreeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LimbusModEditor.App">
    <!--

        plan-09：共享 JSON 编辑器（plan-10 文本工作台 / plan-12 静态工作台共用）。
        plan-17 改动（用户反馈三项）：键值树不再配一个独立的小值输入框，
        **双击叶子行就地编辑值**；删除键改右键菜单 / Delete 键；树空时给空态文案；
        默认展开两层；单层子项过多时分块加载（避免一次物化上万行冻住 UI）。

        形态：Tab「键值树」（惰性展开的 JSON 树 + 行内值编辑 + 右键删除）
              Tab「原文 JSON」（整份文本编辑，非法 JSON 拒绝且不改编辑集）
        行为来源：TextWorkbenchPage 与 StaticWorkbenchPage 的既有实现
        （Flatten / SetNodeValue / RefreshValueEditor / 删除确认 / 非法 JSON 拒绝），
        纯逻辑在 Application/Documents/JsonDocumentEditor.cs（可被单元测试覆盖）。

        本控件不写任何文件、不管导出：一切变更通过 DocumentChanged 事件把
        「当前 JSON 文本 + 是否有修改 + RFC6902 差异 op 数」交给宿主页面。

        颜色/字体只引用 Themes/WorkbenchStyles.xaml 的具名样式（无字面量）。
    -->
    <UserControl.Resources>
        <!--
            行头模板：一行同时容纳「展示文本」与「就地编辑框」，用 IsEditing 切换。
            刻意**不**在编辑时替换 HeaderTemplate——换模板会让 ContentPresenter 重新
            物化整棵行头（正在编辑的那个 TextBox 会连同事件处理一起被丢掉）。
            编辑框出现时把展示文本 Collapsed（而不是 Hidden）：Hidden 仍占位，
            会把编辑框挤到行尾。
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <DataTemplate x:Key="JsonTreeRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 展开箭头：让整行都是展开热区（行内编辑框那段除外） -->
                <ToggleButton Grid.Column="0"
                              Style="{StaticResource WorkbenchTreeExpandToggle}"
                              Margin="-26,0,4,0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}"
                              Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBox Grid.Column="1" Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource WorkbenchValueBox}"
                         MinWidth="200" MaxHeight="120"
                         VerticalAlignment="Center"
                         Loaded="RowEditBox_Loaded"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" SelectionChanged="Tabs_SelectionChanged">
            <!-- ── Tab 1：键值树 ─────────────────────────────────────── -->
            <TabItem Header="🗂 键值树">
                <DockPanel Margin="0,6,0,0">
                    <WrapPanel x:Name="ActionButtons" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ExpandAllButton" Content="展开两层" Click="ExpandRoot_Click"
                                Style="{StaticResource WorkbenchToolButton}" IsEnabled="False"
                                ToolTip="把根与它下面一层容器展开（树按层惰性生成；单层项数很多时分块追加，不会一次物化）。"/>
                        <Button x:Name="CollapseButton" Content="全部收起" Click="CollapseAll_Click"
                                Style="{StaticResource WorkbenchToolButton}" IsEnabled="False"
                                ToolTip="收起到只显示根节点。"/>
                        <TextBlock x:Name="TreeHint" VerticalAlignment="Center" Margin="2,0,0,6"
                                   Style="{StaticResource WorkbenchStatusText}"
                                   Text="双击叶子行改值（Enter 提交 / Esc 取消）；右键行或按 Delete 删除该键。"/>
                    </WrapPanel>
                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Text="—"
                               Style="{StaticResource WorkbenchStatusText}"
                               Margin="4,10,4,0" TextAlignment="Center"/>
                    <TreeView x:Name="Tree" Style="{StaticResource WorkbenchTree}"
                              MinHeight="420"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              ToolTip="JSON 层级；展开节点时即时生成下一层（惰性展开，不截断；单层过多时分块追加）。"/>
                </DockPanel>
            </TabItem>

            <!-- ── Tab 2：原文 JSON ──────────────────────────────────── -->
            <TabItem Header="📄 原文 JSON">
                <DockPanel Margin="0,6,0,0">
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="SaveRawButton" Content="保存原始 JSON 修改" Click="SaveRaw_Click"
                                Style="{StaticResource WorkbenchToolButton}" IsEnabled="False"
                                ToolTip="校验通过后进入宿主编辑集；非法 JSON 一律拒绝且不改动当前文档。"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource WorkbenchSectionLabel}" Margin="0,6,0,0"
                               Text="UTF-8 无 BOM。保存前会校验合法性；失败时当前文档与宿主编辑集都不变。"/>
                    <TextBox x:Name="RawBox" Style="{StaticResource WorkbenchCodeBox}"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 底部：差异摘要 + 状态（宿主可另接 StatusMessage 事件写自己的状态条） -->
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="DiffInfo" Text="—" Style="{StaticResource WorkbenchStatusText}"/>
            <TextBlock x:Name="StatusInfo" Text="—" Style="{StaticResource WorkbenchStatusText}"/>
        </StackPanel>
    </Grid>
</UserControl>
