<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         色板（全应用统一；XAML / 代码请引用这些键，不要再硬编码色值）

         2026-09-18 UI 重构：整组换成本项目 Web 前端的默认深色令牌
         （见 src/LimbusModEditor.Web/src/styles/tokens.css 的 [data-theme='dark']
         与 [data-accent='amber'] 两段）。原生标题栏/状态栏因此与 WebView 内的
         界面同色，不再出现「外面蓝灰、里面紫」的割裂。

         注意：这些是 WebView 外层的原生 chrome，无法跟随前端切换明暗/配色，
         固定使用默认的「深色 + 琥珀」。改动时请同步 tokens.css 的默认值。
         ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16181C"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B1E23"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#22262D"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#2A2F37"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EAEF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B1BD"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#79818D"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#545B66"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D99A3D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E8AB52"/>
    <SolidColorBrush x:Key="ModifiedBrush" Color="#D9A441"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E0575F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#46B17B"/>

    <!-- ══════════════════════════════════════════════════════════════
         隐式样式：所有普通窗口（含代码构建的对话框）默认深色底。
         FluentWindow 自带主题样式优先级更高，不受此影响。
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 状态栏：统一深色底 + 上边框（MainWindow 与代码构建窗口共用） -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource ElevatedBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         具名样式
         ══════════════════════════════════════════════════════════════ -->

    <!-- 工作区小节标题 -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 列表 / 树切换按钮：基于 Fluent ToggleButton，只保留外边距 -->
    <Style x:Key="ViewToggle" TargetType="ToggleButton"
           BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- 目录树行文字：WPF-UI 模板会用较暗的主题文字色，在 #11151A 底上
         对比度不足；BasedOn 保留 Fluent 模板（选中/悬停效果），仅提亮文字。 -->
    <Style TargetType="TreeViewItem"
           BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 主操作按钮（强调色）：用于「新建 / 一键导出」等 CTA -->
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>

</ResourceDictionary>
