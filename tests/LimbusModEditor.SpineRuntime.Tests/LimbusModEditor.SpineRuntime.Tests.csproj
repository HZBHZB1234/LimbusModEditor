<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LimbusModEditor.SpineRuntime.Tests —— Spine 离线渲染类库的单元测试（xUnit）。
    使用合成的最小 Spine 4.0 数据（骨架 JSON + 图集 + 由 SkiaSharp 现画的 PNG），
    覆盖：解析、元信息、region/mesh 渲染非空、不同时间像素不同、缺页/解析失败的中文失败结果、
    PMA 与 rotate:90 不越界等。

    注意：本工程刻意保持独立，不并入主仓库 .slnx，验收时单独用
    `dotnet test tests/LimbusModEditor.SpineRuntime.Tests` 驱动（不跑整个 solution）。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 与 SpineRuntime 类库对齐：不开启 nullable，且把上游警告关掉以免干扰本工程。 -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- 测试工程编译为库，由 VSTest 适配器直接加载 dll 发现测试。 -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LimbusModEditor.SpineRuntime\LimbusModEditor.SpineRuntime.csproj" />
  </ItemGroup>

</Project>
