<ui:FluentWindow x:Class="LimbusModEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LimbusModEditor.App"
        Title="Limbus Mod Editor" Height="720" Width="1280" MinHeight="540" MinWidth="960"
        WindowBackdropType="None" ExtendsContentIntoTitleBar="True" Foreground="#E8EDF2" Closing="Window_Closing"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 活动栏图标按钮（plan-02：6 个页面入口，选中项高亮左侧竖条）。

             图标字体（Segoe MDL2 Assets）刻意只写在按钮内容那个 TextBlock 上，不写在本样式上：
             WPF 的 ToolTip 会继承 PlacementTarget 的字体属性，而符号字体（MDL2 / Fluent Icons 等）
             **没有字体回退**，一旦 RadioButton 自己声明了图标字体，悬浮提示里的中文就会
             全部渲染成豆腐块（□□□□）——这正是「活动栏 6 个按钮的提示全是方块」的根因。
             图标字号/居中不变：按钮仍是 48x44，模板的 ContentPresenter 照旧居中；TextBlock
             自带 FontFamily/FontSize，因此也不受外部字体样式影响。 -->
        <Style x:Key="ActivityButton" TargetType="RadioButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FB0BF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Host" Background="{TemplateBinding Background}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1D242E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="BorderBrush" Value="#4C8DDA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- FluentWindow 自带标题栏（Mica 背景 + 拖动区域 + 窗口按钮） -->
        <ui:TitleBar DockPanel.Dock="Top" Title="Limbus Mod Editor"
                     Padding="12,0" FontWeight="SemiBold"/>
        <Border DockPanel.Dock="Top" Background="{StaticResource ElevatedBackgroundBrush}" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="LIMBUS MOD EDITOR" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="  CREATOR WORKBENCH" Foreground="#8FA6BA"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="新建模组向导…" Click="NewModWizard_Click" Margin="6,0" Padding="14,6"
                            ToolTip="推荐入口：填模组名即可，目录自动配置，创建后自动加载游戏资源。"/>
                    <Button Content="打开项目" Click="OpenProject_Click" Margin="6,0" Padding="14,6"/>
                    <Button Content="保存" Click="SaveProject_Click" Margin="6,0" Padding="14,6"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 下一步提示条：始终告诉用户「现在该做什么」 -->
        <Border x:Name="HintBar" DockPanel.Dock="Top" Background="#223244" Padding="14,7">
            <TextBlock x:Name="HintText" Text="欢迎！" TextWrapping="Wrap"/>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B222B" Foreground="#9FB0BF">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="就绪"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <!-- plan-02 三列布局：48 活动栏 / 220 共享侧边栏 / * 页面宿主 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 活动栏：VS Code 左侧图标栏，直切页面（无顶部标签页） -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivityAssets" ToolTip="资源工作台（搜索 / 按容器浏览资源）" Click="ActivityAssets_Click">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivityBank" ToolTip="音频工作台（Bank 样本浏览 / 试听 / 替换）" Click="ActivityBank_Click">
                        <TextBlock Text="&#xE15D;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivityText" ToolTip="文本工作台（lang 文本）" Click="ActivityText_Click">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivityStatic" ToolTip="静态数据工作台" Click="ActivityStatic_Click">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivityHelp" ToolTip="使用教程" Click="ActivityHelp_Click">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActivityButton}" GroupName="ActivityBar" x:Name="ActivitySettings" ToolTip="设置（共享目录 / 项目元数据）" Click="ActivitySettings_Click">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <!-- 共享侧边栏：所有页面共用、切换页面时不消失（plan-02 需求 5） -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="项目工作区" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="当前项目" Foreground="#7F93A4"/>
                        <TextBlock x:Name="ProjectNameText" Text="未打开项目" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="目录状态（共享配置 · 自动发现）" Foreground="#7F93A4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GameDirectoryStatus" Text="—" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UnityCacheStatus" Text="—" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModDirectoryStatus" Text="—" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FmodDirectoryStatus" Text="—" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <Button Content="重新自动获取目录" Click="AutoConfigure_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="只填充从未配置过的目录（游戏 / Unity 缓存 / 模组 / FMOD）。这些是全局共享设置，保存在程序目录，所有项目共用。"/>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="① 获取资源" Style="{StaticResource SectionLabel}"/>
                        <Button Content="自动加载游戏资源" Click="Scan_Click" Padding="8,6"
                                ToolTip="一键索引游戏 Unity 缓存中的全部资源包（引用模式，不复制文件，重扫近瞬时）。加载完成后在右侧即可按容器目录浏览、搜索并编辑。"/>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="② 产出模组" Style="{StaticResource SectionLabel}"/>
                        <Button Content="导出思路（自动分析）…" Click="ExportIdeas_Click" Padding="8,6" Margin="0,0,0,8"
                                ToolTip="按当前项目里改了什么，自动列出可选出口（Carra2 / Bank / lang 补丁 / 多格式…）并说明区别。"/>
                        <Button x:Name="OneClickExportButton" Content="一键导出模组（推荐）" Click="OneClickExport_Click" Padding="8,6" Style="{StaticResource PrimaryButton}"
                                ToolTip="把资源上的全部修改按真实加载器的 Carra2 布局打包，输出到模组目录即可生效。项目里同时存在音频或包体修改时会先给出导出思路。"/>
                        <Button Content="导出模组（向导）…" Click="Export_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="需要挑选导出范围或格式时使用。"/>
                        <Button Content="导出全部（多格式）" Click="ExportAll_Click" Margin="0,8,0,0" Padding="8,6"/>
                        <!-- lang 文本导出（plan-14 14.5）：编辑集在文本工作台页面对象里，
                             所以这两个入口转调该页面的通道（未打开过页面时引导先改文本）。 -->
                        <Button Content="导出 lang 补丁…" Click="ExportLangPatch_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="把文本工作台里改过的文本导出为 RFC6902 语言补丁（.json），放进模组目录后由加载器在启动时应用、退出时还原。"/>
                        <Button Content="直接应用到 lang 目录…" Click="ApplyLangToGame_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="警告：把文本工作台的修改直接写进游戏 lang 目录（不推荐——优先用「导出 lang 补丁…」；编辑器不负责备份/还原）。"/>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="更多" Style="{StaticResource SectionLabel}"/>
                        <Button Content="打开模组目录" Click="OpenModsDirectory_Click" Padding="8,6"
                                ToolTip="在资源管理器中打开导出目标目录（%APPDATA%\LimbusCompanyMods），方便确认模组文件是否就位。"/>
                        <Button Content="打开项目文件夹" Click="OpenProjectFolder_Click" Margin="0,8,0,0" Padding="8,6"/>
                        <Button Content="音频工作台…" Click="ActivityBank_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="按 FMOD Bank 浏览音频样本、试听与替换。"/>
                        <Button Content="文本工作台（lang 补丁）…" Click="ActivityText_Click" Margin="0,8,0,0" Padding="8,6"
                                ToolTip="直接编辑游戏文本表，导出为语言补丁。"/>
                        <Button Content="静态数据工作台…" Click="ActivityStatic_Click" Margin="0,8,0,0" Padding="8,6"/>
                        <Separator Margin="0,14"/>
                        <Button Content="设置（共享目录 / 项目元数据）…" Click="ActivitySettings_Click" Padding="8,6"
                                ToolTip="共享目录保存在程序目录，所有项目共用；模组名称、作者等元数据属于本项目。"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- 页面宿主：常驻页面按 key 惰性创建，切换只换内容不销毁 -->
            <ContentControl x:Name="PageHost" Grid.Column="2" Background="#11151A"/>
            <!-- 无项目引导覆盖层：只遮住页面宿主（设置/教程页无项目时仍可用） -->
            <Border x:Name="NoProjectOverlay" Grid.Column="2" Background="#E511151A" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="开始制作模组" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="新建或打开一个模组项目后，编辑器会自动配置游戏目录并要求加载游戏资源；&#x0a;加载完成即可按容器目录浏览、搜索、替换、编辑，最后一键导出到模组目录。"
                               TextAlignment="Center" Foreground="#8FA6BA" TextWrapping="Wrap" Margin="0,10,0,22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="新建模组项目（推荐）" Click="NewModWizard_Click" Padding="18,9,18,9" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="打开项目…" Click="OpenProject_Click" Padding="18,9,18,9" FontSize="14"/>
                    </StackPanel>
                    <TextBlock Text="提示：游戏资源加载是引用模式，不会复制或修改任何游戏文件。"
                               TextAlignment="Center" Foreground="#5F7285" FontSize="11" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
