<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LimbusModEditor.SpineRuntime —— Spine 4.0 骨骼动画离线渲染类库。

    注意：本工程故意覆盖仓库根 Directory.Build.props 的以下默认值：
      * Nullable        = disable   （vendored 的 spine-csharp 官方源码不是 nullable 标注的，
                                      启用 nullable 会产生大量与其无关的 CS86xx 警告，
                                      而我们的任务是“不为了消警告大改官方源码”）
      * TreatWarningsAsErrors = false（同理，vendored 源码的历史警告不应阻断本工程构建）
    同时用 NoWarn 显式抑制 vendored 源码在 net8.0 下产生的、与本项目逻辑无关的历史警告
    （这些警告的代码清单见 THIRD-PARTY-NOTICES.md）。本项目自身新增代码保持零警告。

    本工程不引用 WPF（TargetFramework = net8.0 而非 net8.0-windows），渲染走 SkiaSharp，
    以便日后也可在 CLI / 服务端等无桌面环境复用。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 仅用于抑制 third_party/spine-csharp（上游 2013-2020 官方源码）在 net8.0 / Nullable=disable
         下产生的、与本项目逻辑无关的历史警告；本项目自身新增代码保持零警告。
           * CS8632 —— 可空注解（?）出现在非 #nullable 标注上下文（vendored 源码未启用 nullable）。 -->
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp：net8.0 可用的最新稳定版，用于把图集页 PNG 解码为位图并离屏绘制。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接把 vendored 的官方 spine-csharp 核心源码收编进本工程（排除 XNA/渲染层，
         因为 spine-csharp 的 src 是纯 C# 核心；XNA 引用仅存在于 #if WINDOWS_PHONE 分支，
         在 net8.0 下不会编译）。保留 .meta（Unity 元数据）之外所有 .cs。 -->
    <Compile Include="..\..\third_party\spine-csharp\src\**\*.cs" />
    <Compile Remove="..\..\third_party\spine-csharp\src\**\*.meta" />
  </ItemGroup>

</Project>
