<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 允许 Domain.Tests、Application.Tests 和 App 访问 internal 类型（IpcJson 等） -->
    <InternalsVisibleTo Include="LimbusModEditor.Domain.Tests" />
    <InternalsVisibleTo Include="LimbusModEditor.Application.Tests" />
    <InternalsVisibleTo Include="LimbusModEditor.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LimbusModEditor.Domain\LimbusModEditor.Domain.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Abstractions\LimbusModEditor.Formats.Abstractions.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Carra\LimbusModEditor.Formats.Carra.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Lunartique\LimbusModEditor.Formats.Lunartique.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Bank\LimbusModEditor.Formats.Bank.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Rebank\LimbusModEditor.Formats.Rebank.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Unity\LimbusModEditor.Formats.Unity.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Editing\LimbusModEditor.Editing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- nlog.config 内嵌一份：万一输出目录里被删/被改坏，也能从程序集内还原，
         日志系统不会因为配置文件问题而失效（见 Application/Diagnostics/NLogBootstrap.cs）。 -->
    <EmbeddedResource Include="..\..\nlog.config" LogicalName="nlog.config" />
  </ItemGroup>

</Project>
