<UserControl x:Class="LimbusModEditor.App.AssetsWorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LimbusModEditor.App">
    <!-- 资源右键菜单：列表与目录树共用（内容以「用户能做的操作」为主，不暴露技术字段） -->
    <UserControl.Resources>
        <ContextMenu x:Key="AssetContextMenu">
            <MenuItem Header="替换…（图像双击同效）" Click="ReplaceAsset_Click"/>
            <MenuItem Header="编辑文本内容…" Click="EditTextAsset_Click"/>
            <MenuItem Header="Unity 字段编辑" Click="EditUnityFields_Click"/>
            <MenuItem Header="十六进制预览" Click="HexPreview_Click"/>
            <Separator/>
            <MenuItem Header="撤销此资源的修改" Click="ClearEdits_Click"/>
            <Separator/>
            <MenuItem Header="复制资源路径" Click="CopyAssetPath_Click"/>
        </ContextMenu>
        <!-- 棋盘格透明底（plan-05：图像预览的透明区域可见） -->
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource WbCheckerDarkBrush}" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="{StaticResource WbCheckerLightBrush}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid Margin="12">
        <!-- plan-04：浏览列与预览列之间加 GridSplitter；预览列默认 360、
             最小 260，浏览列最小 280。占比经 UiStateService 持久化。 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="360" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <!-- 中栏：搜索 / 筛选 / 浏览（plan-03：搜索行只留搜索框，手动导入入口全部移除） -->
        <Border Grid.Column="0" Background="{StaticResource WbPanelBrush}" BorderBrush="{StaticResource WbBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Width="300" Height="28" VerticalContentAlignment="Center" ToolTip="搜索资源名称或路径（支持中文名 / 原路径）" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="类型" VerticalAlignment="Center" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,0,4,0"/>
                    <ComboBox x:Name="TypeFilter" Width="110" Height="28" SelectionChanged="Filter_Changed" ToolTip="按资源类型筛选"/>
                    <TextBlock Text="状态" VerticalAlignment="Center" Foreground="{StaticResource WbTextMutedBrush}" Margin="8,0,4,0"/>
                    <ComboBox x:Name="StateFilter" Width="100" Height="28" SelectionChanged="Filter_Changed" ToolTip="按修改状态筛选"/>
                    <TextBlock Text="排序" VerticalAlignment="Center" Foreground="{StaticResource WbTextMutedBrush}" Margin="8,0,4,0"/>
                    <ComboBox x:Name="SortFilter" Width="120" Height="28" SelectedIndex="0" SelectionChanged="Filter_Changed" ToolTip="结果排序方式">
                        <ComboBoxItem Content="按名称"/>
                        <ComboBoxItem Content="按大小（大→小）"/>
                        <ComboBoxItem Content="按大小（小→大）"/>
                        <ComboBoxItem Content="按类型"/>
                        <ComboBoxItem Content="修改在前"/>
                    </ComboBox>
                    <CheckBox x:Name="ContainerOnlyFilter" Content="仅显示容器内资源" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"
                              ToolTip="只列出能在游戏容器（m_Container）里找到的资源，即游戏真正加载的那些。"/>
                    <CheckBox x:Name="ShowStaticFilter" Content="显示静态数据表" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"
                              ToolTip="静态数据 bundle（static_s1_0_assets_all_*）里的表默认不在资源工作台显示，请到「🧩 静态数据工作台」编辑；勾选后此处也可见。"/>
                    <Button Content="清除筛选" Click="ClearFilters_Click" Margin="10,0,0,0" Padding="10,3"/>
                </StackPanel>
                <Expander DockPanel.Dock="Top" Header="高级筛选" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="最小 KB" VerticalAlignment="Center" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,0,4,0"/>
                        <TextBox x:Name="MinSizeFilter" Width="60" Height="28" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="最大 KB" VerticalAlignment="Center" Foreground="{StaticResource WbTextMutedBrush}" Margin="8,0,4,0"/>
                        <TextBox x:Name="MaxSizeFilter" Width="60" Height="28" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <CheckBox x:Name="ReplacedOnlyFilter" Content="仅已替换" VerticalAlignment="Center" Margin="10,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </StackPanel>
                </Expander>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ToggleButton x:Name="AssetViewListToggle" Style="{StaticResource ViewToggle}" Content="☰ 列表"
                                  Click="AssetViewMode_Click" ToolTip="扁平列表视图（当前搜索结果）"/>
                    <ToggleButton x:Name="AssetViewTreeToggle" Style="{StaticResource ViewToggle}" Content="🗂 目录树"
                                  IsChecked="True" Click="AssetViewMode_Click" ToolTip="按游戏容器目录浏览（类文件夹，双击展开）"/>
                </StackPanel>
                <Grid>
                    <ListView x:Name="AssetList" Visibility="Collapsed" Background="{StaticResource WbListBrush}" BorderBrush="{StaticResource WbBorderBrush}" Foreground="{StaticResource WbTextPrimaryBrush}" SelectionChanged="AssetList_SelectionChanged"
                             MouseDoubleClick="AssetList_DoubleClick" PreviewMouseRightButtonDown="AssetList_PreviewMouseRightButtonDown"
                             ContextMenu="{StaticResource AssetContextMenu}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding DisplayPath}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Modified">
                                        <Setter Property="Foreground" Value="{StaticResource WbModifiedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="360"/>
                                <GridViewColumn Header="类型" DisplayMemberBinding="{Binding TypeLabel}" Width="110"/>
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding StateLabel}" Width="90"/>
                                <GridViewColumn Header="大小" DisplayMemberBinding="{Binding Size, Converter={StaticResource HumanSize}}" Width="90"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TreeView x:Name="AssetTree"
                              Background="{StaticResource WbListBrush}" BorderBrush="{StaticResource WbBorderBrush}" Foreground="{StaticResource WbTextPrimaryBrush}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ContextMenu="{StaticResource AssetContextMenu}"
                              PreviewMouseRightButtonDown="AssetTree_PreviewMouseRightButtonDown"
                              SelectedItemChanged="AssetTree_SelectedItemChanged"
                              MouseDoubleClick="AssetTree_DoubleClick"
                              TreeViewItem.Expanded="AssetTree_Expanded"
                              ToolTip="按游戏容器目录浏览；展开目录即时生成下一层。"/>
                </Grid>
            </DockPanel>
        </Border>
        <!-- 拖拽把手：拖动调整预览列宽度；双击复位默认并持久化 -->
        <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="True"
                      Background="Transparent" Cursor="SizeWE"
                      PreviewMouseLeftButtonUp="PreviewSplitter_DragCompleted"
                      MouseDoubleClick="PreviewSplitter_DoubleClick"
                      ToolTip="拖拽调整预览区宽度；双击复位默认占比。">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border x:Name="Handle" Width="1" HorizontalAlignment="Center" Background="{StaticResource WbBorderBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{StaticResource WbAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <!-- 右栏：预览与选中资源操作 -->
        <Border Grid.Column="2" Background="{StaticResource WbPanelBrush}" BorderBrush="{StaticResource WbBorderBrush}" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="创作状态" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="资源" Foreground="{StaticResource WbTextMutedBrush}"/>
                    <TextBlock x:Name="AssetCountText" Text="0" FontSize="24" Margin="0,2,0,14"/>
                    <TextBlock Text="编辑操作" Foreground="{StaticResource WbTextMutedBrush}"/>
                    <TextBlock x:Name="EditCountText" Text="0" FontSize="24" Margin="0,2,0,4"/>
                    <TextBlock Text="（按「已修改资源」数统计，同一资源重复替换只算一次）" Foreground="{StaticResource WbTextFaintBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Separator Margin="0,4,0,12"/>
                    <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <!-- plan-05：预览区按 Kind 切换（图像/文本/JSON/音频/行/十六进制/说明） -->
                    <ContentControl x:Name="PreviewHost" MinHeight="150"/>
                    <TextBlock x:Name="PreviewInfoText" Text="无预览" Foreground="{StaticResource WbTextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <!-- plan-01 第 3 步：选中资源属性（异步加载，代际守卫） -->
                    <Expander x:Name="PropertyExpander" Header="属性" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="PropertyInfoText" Text="—" Foreground="{StaticResource WbTextFaintBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,6"/>
                            <ItemsControl x:Name="PropertyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource WbTextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{StaticResource WbCodeForegroundBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="选中资源" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="名称" Foreground="{StaticResource WbTextMutedBrush}"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="SelectedAssetNameText" Text="未选择" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="位置" Foreground="{StaticResource WbTextMutedBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="SelectedAssetPathText" Text="—" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="类型" Foreground="{StaticResource WbTextMutedBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedAssetTypeText" Text="—"/>
                        <TextBlock Grid.Row="3" Text="大小" Foreground="{StaticResource WbTextMutedBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="SelectedAssetSizeText" Text="—"/>
                        <TextBlock Grid.Row="4" Text="状态" Foreground="{StaticResource WbTextMutedBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="SelectedStateText" Text="—"/>
                    </Grid>
                    <TextBlock Text="常用" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,14,0,6"/>
                    <Button x:Name="ReplaceAssetButton" Content="替换选中资源…（可直接拖图进来）" Click="ReplaceAsset_Click" IsEnabled="False" Padding="8,6"/>
                    <Button x:Name="EditTextButton" Content="编辑文本内容…" Click="EditTextAsset_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"
                            ToolTip="文本 / JSON 资源的内置编辑器：改完保存即登记为替换（可撤销，导出时写入模组）。"/>
                    <Button x:Name="ClearEditsButton" Content="撤销此资源的修改" Click="ClearEdits_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"
                            ToolTip="清除替换文件 / Unity 字段 / Sprite 元数据三类编辑标记；导出将不再包含此资源的修改。"/>
                    <Expander Header="高级操作" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,14,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <StackPanel x:Name="AtlasPanel" Visibility="Collapsed">
                                <TextBlock Text="图集工具" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0"><TextBlock Text="列" Foreground="{StaticResource WbTextMutedBrush}"/><TextBox x:Name="AtlasColumnsBox" Text="2" Height="24"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="行" Foreground="{StaticResource WbTextMutedBrush}"/><TextBox x:Name="AtlasRowsBox" Text="2" Height="24"/></StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SplitAtlasButton" Content="拆分图集" Click="SplitAtlas_Click" IsEnabled="False" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button x:Name="RepackAtlasButton" Content="恢复图集" Click="RepackAtlas_Click" IsEnabled="False" Padding="8,4"/>
                                </StackPanel>
                                <Separator Margin="0,10"/>
                            </StackPanel>
                            <Button Content="从文件夹批量登记替换…" Click="BatchReplace_Click" Padding="8,6"/>
                            <Button x:Name="UnityFieldsButton" Content="Unity 字段编辑" Click="EditUnityFields_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="SpriteMetadataButton" Content="查看 Sprite 元数据" Click="InspectSprite_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="ReferencersButton" Content="查找谁引用了此对象" Click="FindReferencers_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="ObjectSummaryButton" Content="查看对象摘要（Mesh/动画/字体）" Click="ShowObjectSummary_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="HexPreviewButton" Content="十六进制预览" Click="HexPreview_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="DecodeAudioButton" Content="导出当前音频 WAV" Click="DecodeAudio_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                            <Button x:Name="FsbInspectButton" Content="查看 FSB 结构" Click="InspectFsb_Click" IsEnabled="False" Margin="0,8,0,0" Padding="8,6"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="调试" Foreground="{StaticResource WbTextMutedBrush}" Margin="0,12,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="调试状态" Foreground="{StaticResource WbTextMutedBrush}"/>
                            <TextBlock x:Name="DebugStateText" Text="未应用" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <Button Content="构建调试覆盖层" Click="BuildOverlay_Click" Padding="8,6"/>
                            <Button Content="应用并启动调试" Click="DebugApply_Click" Margin="0,8,0,0" Padding="8,6"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
