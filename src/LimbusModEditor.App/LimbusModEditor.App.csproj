<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LimbusModEditor.Application\LimbusModEditor.Application.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Infrastructure\LimbusModEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Domain\LimbusModEditor.Domain.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Editing\LimbusModEditor.Editing.csproj" />
    <ProjectReference Include="..\LimbusModEditor.Formats.Unity\LimbusModEditor.Formats.Unity.csproj" />
    <!--
      Spine 4.0 骨骼动画离线渲染（vendored spine-csharp + SkiaSharp）。
      应用层只负责「找到骨架/图集/贴图素材 + 把渲染出的帧贴到界面」，
      真正的解析与绘制都在这个类库里（net8.0，无 WPF 依赖）。
    -->
    <ProjectReference Include="..\LimbusModEditor.SpineRuntime\LimbusModEditor.SpineRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 日志配置随程序发布：autoReload 生效时可在运行中直接改级别（见 docs/LOGGING.md）。 -->
    <None Include="..\..\nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
