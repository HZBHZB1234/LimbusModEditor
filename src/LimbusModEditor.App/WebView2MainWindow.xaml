<ui:FluentWindow x:Class="LimbusModEditor.App.WebView2MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Limbus Mod Editor" Height="800" Width="1280" MinHeight="540" MinWidth="960"
        WindowBackdropType="None" ExtendsContentIntoTitleBar="True" Foreground="#E8EDF2">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Limbus Mod Editor" Padding="12,0" FontWeight="SemiBold"/>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B222B" Foreground="#9FB0BF">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="正在初始化 WebView2…"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="RuntimeVersionText" Foreground="#5CC97A"/></StatusBarItem>
        </StatusBar>
        <Border x:Name="WebViewHost" Background="#11151A"/>
    </DockPanel>
</ui:FluentWindow>
