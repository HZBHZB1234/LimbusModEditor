# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Node / Web build artifacts
node_modules/
dist/

# AI 工具的工作目录（WorkBuddy 等会在仓库根落 .workbuddy* 记忆/状态文件）
.workbuddy/
.workbuddy-ai/

# Publish artifacts
artifacts/

# Visual Studio cache/options
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json

# Test results
[Tt]est[Rr]esult*/
TestResults/
*.coverage
*.coveragexml

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.bak
*.swp
*~
# WPF 构建期临时工程（XAML 编译用，正常构建后自行删除；偶发残留不入库）
*_wpftmp.csproj
*_wpftmp.*
# 索引/表缓存（运行时生成，可随时删除重建；unity-cache-index.db 等）
cache/

# FMOD 二进制不入库（许可要求）；发布脚本会把它复制进安装包
third_party/fmod/

# 智能体工作区（记忆 / 技能 / 临时探针产物）：属于本机开发状态，不入库
.workbuddy/

# AgentTeams 协作状态（成员 / 任务 / 邮箱，随会话变化）：属于本机开发状态，不入库
.agent-teams/
