<?xml version="1.0" encoding="utf-8"?>
<!--
  Limbus Mod Editor 日志配置（NLog 6.x）

  设计要点（详见 docs/LOGGING.md）：
  · autoReload="true" —— 程序运行中改这个文件立即生效（诊断现场可以临时把 minlevel 调到 Trace，
    不用重启软件）。想临时只看 Info：把下面 rules 里的 minlevel 改掉即可。
  · logdir 变量由 Application/Diagnostics/NLogBootstrap.cs 注入：默认 <程序目录>/logs，
    可用环境变量 LME_LOG_DIR 覆盖；程序目录不可写时自动退到 %TEMP%/LimbusModEditor-logs。
  · 两个文件：current.log（本次会话全量，启动时把上次的归档成 lme-session-*.log）
    与 errors.log（只收 Error/Fatal，跨会话追加，方便直接定位报错）。
  · 所有文件 target 都套 AsyncWrapper + overflowAction="Discard"：
    写盘在 NLog 后台线程，UI 线程永远不会被日志 IO 阻塞；队列满了丢弃而不是卡住程序。
  · console target 默认由代码在 LME_LOG_CONSOLE=1 时才启用（WinExe 没有控制台）。
  · memory target 只留最近 2000 条：UI「复制最近日志」与崩溃快照读它。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false"
      internalLogLevel="Off">

  <variable name="logdir" value="${basedir}/logs" />
  <!-- 每行固定列：时间 级别 线程 方法(文件:行号) 消息（异常另起一段）—— 便于肉眼扫与 grep。 -->
  <variable name="fileLayout"
            value="${longdate} ${level:uppercase=true:padding=-5} t${threadid:padding=2} ${callsite:className=false:methodName=true:fileName=true:includeSourcePath=false} ${message}${onexception:inner=${newline}${exception:format=ToString}}" />

  <targets>
    <!-- 本次会话全量日志 -->
    <target xsi:type="AsyncWrapper" name="sessionAsync" queueLimit="200000" overflowAction="Discard">
      <target xsi:type="File" name="sessionFile"
              fileName="${var:logdir}/current.log"
              layout="${var:fileLayout}"
              encoding="utf-8"
              createDirs="true"
              keepFileOpen="false"
              concurrentWrites="false"
              archiveOldFileOnStartup="true"
              archiveFileName="${var:logdir}/lme-session-{#}.log"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd-HHmmss"
              archiveAboveSize="33554432"
              maxArchiveFiles="20" />
    </target>

    <!-- 错误汇总（只收 Error/Fatal，跨会话追加） -->
    <target xsi:type="AsyncWrapper" name="errorsAsync" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="errorsFile"
              fileName="${var:logdir}/errors.log"
              layout="${var:fileLayout}"
              encoding="utf-8"
              createDirs="true"
              keepFileOpen="false"
              concurrentWrites="false"
              archiveAboveSize="8388608"
              archiveFileName="${var:logdir}/lme-errors-{#}.log"
              archiveNumbering="Date"
              archiveDateFormat="yyyyMMdd-HHmmss"
              maxArchiveFiles="5" />
    </target>

    <!-- 内存环形缓冲：UI 展示 / 崩溃快照 -->
    <target xsi:type="Memory" name="memory" layout="${var:fileLayout}" maxLogs="2000" />

    <!-- 控制台（默认被代码移除；LME_LOG_CONSOLE=1 时启用） -->
    <target xsi:type="Console" name="console" layout="${var:fileLayout}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="memory" />
    <logger name="*" minlevel="Trace" writeTo="sessionAsync" />
    <logger name="*" minlevel="Error" writeTo="errorsAsync" />
    <logger name="*" minlevel="Trace" writeTo="console" />
  </rules>
</nlog>
