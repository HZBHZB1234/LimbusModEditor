<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         色板（全应用统一；XAML / 代码请引用这些键，不要再硬编码色值）
         ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#11151A"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#171D24"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#1B222B"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1D242E"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#2A3540"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FB0BF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7F93A4"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#5F7285"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DDA"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5F9DE8"/>
    <SolidColorBrush x:Key="ModifiedBrush" Color="#FFD37A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D9554F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CB77C"/>

    <!-- ══════════════════════════════════════════════════════════════
         隐式样式：所有普通窗口（含代码构建的对话框）默认深色底。
         FluentWindow 自带主题样式优先级更高，不受此影响。
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 状态栏：统一深色底 + 上边框（MainWindow 与代码构建窗口共用） -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource ElevatedBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         具名样式
         ══════════════════════════════════════════════════════════════ -->

    <!-- 工作区小节标题 -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 列表 / 树切换按钮：基于 Fluent ToggleButton，只保留外边距 -->
    <Style x:Key="ViewToggle" TargetType="ToggleButton"
           BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- 目录树行文字：WPF-UI 模板会用较暗的主题文字色，在 #11151A 底上
         对比度不足；BasedOn 保留 Fluent 模板（选中/悬停效果），仅提亮文字。 -->
    <Style TargetType="TreeViewItem"
           BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 主操作按钮（强调色）：用于「新建 / 一键导出」等 CTA -->
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>

</ResourceDictionary>
