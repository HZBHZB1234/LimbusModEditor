<UserControl x:Class="LimbusModEditor.App.WorkbenchShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--

        plan-09：工作台公共骨架（三列：浏览 / 分隔条 / 预览编辑）。

        设计令牌与控件样式全部来自 Themes/WorkbenchStyles.xaml——本文件与任何页面
        代码里都不出现色值字面量（验收 grep 门）。资源工作台（AssetsWorkbenchPage）
        的外观即由此骨架描述：面板底 / 列表底 / 1px 边框 / splitter 1px 竖线 +
        hover 主色 / 浏览列 * MinWidth 280 / 编辑列默认 360 MinWidth 260。

        页面接线方式（plan-10/11/12 消费）：
          var shell = new WorkbenchShell(host, WorkbenchPageKeys.Text);
          shell.AddSearchItem(searchBox);
          shell.AddFilterItem(kindFilter);
          shell.AddViewToggles();
          shell.SetBrowseContent(treeOrList);
          shell.SetEditContent(editorPanel);
          shell.SetStatus("…");
          shell.SetEmptyHint("没有找到 lang 目录…");
    -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="360" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- 浏览列：搜索行 → 筛选行 → 视图切换对 → 内容（空态提示覆盖在内容之上） -->
        <Border Grid.Column="0" Style="{StaticResource WorkbenchBrowsePanel}">
            <DockPanel>
                <StackPanel x:Name="SearchRowHost" DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="0,0,0,6" Visibility="Collapsed"/>
                <StackPanel x:Name="FilterRowHost" DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="0,0,0,8" Visibility="Collapsed"/>
                <StackPanel x:Name="ViewToggleRowHost" DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="0,0,0,8" Visibility="Collapsed"/>
                <Grid>
                    <ContentControl x:Name="BrowseHost"/>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource WorkbenchEmptyHint}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 拖拽把手：1px 竖线、hover 主色、双击复位（行为与资源工作台一致） -->
        <GridSplitter x:Name="PreviewSplitter" Grid.Column="1"
                      Style="{StaticResource WorkbenchSplitter}"
                      PreviewMouseLeftButtonUp="PreviewSplitter_DragCompleted"
                      MouseDoubleClick="PreviewSplitter_DoubleClick"
                      ToolTip="拖拽调整预览/编辑区宽度；双击复位默认宽度。"/>

        <!-- 预览/编辑列：内容 + 底部状态条 -->
        <Border Grid.Column="2" Style="{StaticResource WorkbenchEditPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ContentControl x:Name="EditHost"/>
                <Border Grid.Row="1" BorderBrush="{StaticResource WbBorderBrush}" BorderThickness="0,1,0,0"
                        Margin="0,8,0,0" Padding="0,2,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource WorkbenchStatusText}" Text="—"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
